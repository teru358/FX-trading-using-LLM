# ============================================================
# モード + プロバイダ選択
# ============================================================
# mode:
#   "paper"     — 仮想資金でシミュレーション (デフォルト)
#   "live"      — 実取引 (live_broker 必須)
#   "live_test" — paper + live_broker 観察を同時実行 (実発注なし、検証用)
mode: paper

# paper_provider: paper モードの価格源 + live モードのフォールバック源
#   "yfinance"   — 無料 (15-20 分遅延、API キー不要)
#   "twelvedata" — リアルタイム (要 TWELVEDATA_API_KEY、設定: providers/twelvedata.yaml)
paper_provider: yfinance

# live_broker: 実取引時のブローカー (mode in {live, live_test} で必須)
#   "mt5"   — MT5 bridge 経由 (設定: providers/mt5.yaml)
#   "oanda" — OANDA REST API (設定: providers/oanda.yaml、未実装)
#   null    — paper モードのとき
live_broker: null

logging:
  level: "INFO"
  file: "logs/finance.log"
  activity_log_file: "logs/activity.log"  # [COLLECT][NEWS][SIGNAL][CLOSE][TRADE][ORDER][REFLECT] 専用
  rotate_timing: "10MB"  # サイズ: 10MB / 512KB など。時間: 6H（毎6時間）/ 1D（毎日）/ midnight（日次0時）/ W0（月曜）
  backup_count: 5

api:
  enabled: false             # true で REST API サーバーを起動
  port: 8811                 # リッスンポート
  run_trade_soft_timeout_sec: 10   # POST /run/trade: この秒数内に完了したら同期返答、超過で非同期化+webhook
  ask_soft_timeout_sec: 60         # POST /ask: 同上
  # 認証: .env の API_SECRET_KEY を設定（X-API-Key ヘッダーで送信）

# ============================================================
# LLM 設定 — provider を 1 つ選び、3 役割すべて同じ provider で動かす
#
# provider に応じて意味のあるフィールドが provider_config 側で異なる:
#   ollama / llamacpp — base_url 必須（空欄なら起動時 ConfigError）
#   claude-cli        — command (空欄なら "claude" 補完) / isolated_cwd / extra_args
#   claude (API)      — max_tokens (0 なら 4096 補完) / API キーは ANTHROPIC_API_KEY
#   gemini / openai   — API キーは GEMINI_API_KEY / OPENAI_API_KEY
#
# 各役割は model のみを provider に合わせて差し替える:
#   ollama:     "llama3.1:8b" など
#   llamacpp:   llama-swap config.yaml の models.<name> と一致
#   claude-cli: "claude-haiku-4-5" / "claude-sonnet-4-6"
#   claude:     "claude-haiku-4-5-20251001" など
#   gemini:     "gemini-2.0-flash" など
#   openai:     "gpt-4o-mini" など
# ============================================================
llm:
  # 使用する LLM プロバイダー (1 つだけ選ぶ)
  # 候補: ollama / llamacpp / claude-cli / claude / gemini / openai
  provider: "claude-cli"

  # provider 共通の接続設定 (該当 provider で意味のあるフィールドのみ使われる)
  provider_config:
    # ollama / llamacpp で必須。空欄なら起動時 ConfigError。
    # 例: ollama   → "http://localhost:11434"
    #     llamacpp → "http://localhost:8080/v1"
    base_url: ""
    # claude-cli の実行コマンド (空欄なら "claude" を PATH 解決)
    command: ""
    # claude-cli の隔離 cwd (CLAUDE.md/skills 汚染回避。例 "/opt/finance-cli")
    isolated_cwd: ""
    # claude-cli の追加引数 (例: ["--dangerously-skip-permissions"])
    extra_args: []
    # claude (API) の応答最大トークン (0 のままなら 4096 補完)
    max_tokens: 0
    # 共通: HTTP / プロセスタイムアウト秒
    timeout_seconds: 120
    # 共通: リトライ回数
    max_retries: 2
    # 共通: 同時呼び出し上限 (Semaphore に渡る)
    max_concurrent: 2

  # 各役割で使うモデルと温度
  news_analysis:
    model: "claude-haiku-4-5"
    temperature: 0.3
  price_analysis:
    model: "claude-sonnet-4-6"
    temperature: 0.1
  reflection:
    model: "claude-haiku-4-5"
    temperature: 0.3

# instruments → config/instruments.yaml に分離
# price_provider 設定 → config/providers/twelvedata.yaml (paper_provider=twelvedata 時)

trading:
  # 残高は state/balance.json (balance_snapshot) を真実のソースとして読む。
  # paper モードは初期化時に ¥100,000 で seed、live/live_test モードは MT5 から取得する。
  risk_per_trade: 0.02
  signal_confidence_threshold: 0.55     # この confidence 未満は hold
  # min_rr_ratio — planned R:R がこの値未満なら hold に差し戻す (0 = 無効)
  # 新規運用では 0 のまま、audit で 30 件以上溜まってから tiny TP が目立つなら 1.2〜1.5 を検討
  min_rr_ratio: 0.0
  lookback_days: 90
  ohlcv_interval: "1h"             # yfinance の足種（1h足で毎時:00のテクニカル分析に対応）
  news_weight: 0.20                     # テクニカル主導 (LLM ニュース分析はノイジーなため price 側を厚く)
  price_weight: 0.80
  signal_deadband: 0.15            # BUY/SELL判定のスコア閾値（±）
  min_lot_size: 1000.0             # 最小ロットサイズ
  lot_unit: 1000.0                 # ロット切り捨て単位
  # ポジション再評価（Phase 4a: Layer 1〜3）
  # Phase 3c は OFF 固定。Phase 4 で
  # docs/superpowers/plans/2026-05-14-incident-driven-safety-hardening.md
  # Task 3 のガード (price source != "mt5" / soft halt 中の close 抑制) を
  # 導入した後に true への再切替を検討する。
  position_review_enabled: false        # Phase 3c OFF (Phase 4 で再評価)
  reversal_confidence_min: 0.70         # Layer 1: 反転シグナルの最低信頼度
  reversal_score_threshold: 0.25        # Layer 1: 反転スコアの絶対値閾値
  # Position management v2
  reversal_min_holding_minutes: 240
  reversal_guard_enabled: true
  reversal_close_enabled: false
  reversal_consecutive_required: 2
  reversal_raise_sl_to_breakeven: true
  time_stop_enabled: true
  no_progress_enabled: true
  no_progress_watch_hours: 6
  no_progress_exit_hours: 12
  no_progress_min_mfe_r: 0.1
  no_progress_requires_signal_weakness: true
  stale_position_review_hours: 24
  timeout_cooldown_hours: 4
  stale_signal_hours: 8
  session_end_flatten_enabled: false
  profit_protection_enabled: true
  protect_half_r: 0.3
  protect_breakeven_r: 0.5
  protect_lock_r: 1.0
  giveback_close_r: 0.4
  giveback_close_min_mfe_r: 0.8
  remote_sl_sync_enabled: false
  # RAG方向別スコア補正
  rag_adjustment_enabled: true
  rag_adjustment_max: 0.15
  rag_adjustment_min_hits: 2
  rag_adjustment_search_top_n: 5
  rag_adjustment_same_weight: 0.10
  rag_adjustment_opposite_weight: 0.10
  rag_adjustment_trade_multiplier: 1.0
  rag_adjustment_forecast_multiplier: 0.5
  rag_adjustment_hold_multiplier: 0.3
  # ATRベースSL/TP
  atr_timeframe: "4h"                 # ATR計算用の足種 ("1h"/"4h"/"1d")。テクニカル分析の ohlcv_interval とは独立
  sl_atr_mult_default: 3.0            # SL距離 = ATR(14, atr_timeframe) × この倍率
  tp_atr_mult_default: 6.0            # TP距離 = ATR(14, atr_timeframe) × この倍率
  sl_atr_mult_min: 1.0                # LLM動的更新の下限
  sl_atr_mult_max: 5.0                # LLM動的更新の上限
  tp_atr_mult_min: 2.0
  tp_atr_mult_max: 10.0
  # TradingView テクニカルサマリー (矛盾検出)
  tv_summary_enabled: false      # TV判定と方向矛盾時にconfidence減衰
  tv_conflict_dampen: 0.7        # 矛盾時のconfidence倍率
  # ペアごとのポジション数上限 (1 ペアでの最大累積 open ポジ数)
  max_positions_per_pair: 2              # scale-in 含めて 1 ペアで最大 N ポジ
  # Scale-in (順張り増し玉): 既存ポジと同方向で強い signal が来た時に追加発注
  scale_in_enabled: false                # フラグ式段階導入: 初期 OFF
  scale_in_conf_margin: 0.05             # confidence 上回り幅
  scale_in_score_margin: 0.05            # |combined_score| 上回り幅
  # Drawdown kill switch — 新規エントリーのみ停止 (既存ポジションは維持)
  # 運用保険。新規運用時は false のままで OK、audit で DD 履歴を確認してから有効化を検討
  drawdown_kill_switch_enabled: false
  drawdown_kill_switch_max_pct: 0.10    # peak equity からこの割合以上落ちたら新規停止 (0.10 = 10%)
  # ボラレジーム (EWMA ベース position sizing)
  vol_regime_enabled: false
  vol_regime_ewma_span: 20              # ATR(14) の EWMA 期間 (bar 数)
  vol_regime_high_threshold: 1.3        # ATR/EWMA > 1.3 → high vol (risk 縮小)
  vol_regime_low_threshold: 0.7         # ATR/EWMA < 0.7 → low vol
  vol_regime_high_risk_scale: 0.5       # high vol 時の risk_per_trade 倍率
  vol_regime_low_risk_scale: 1.0        # low vol 時 (= 通常と同じ。拡大はリスク増なので慎重に)

  # Forecast accuracy auto-feedback (直近サイクルの予測精度を signal に反映)
  # 直近 lookback_hours 内の reviewed forecast の hit 率 (predicted_direction が当たった率) が:
  #   - soft_threshold 未満 → confidence × confidence_penalty (signal は弱化、action は不変)
  #   - hard_threshold 未満 → action="hold" を強制 (誤った方向への新規 entry を抑止)
  # min_samples 未満のサンプル数では適用しない (false positive 防止)。
  forecast_accuracy_feedback:
    enabled: false
    lookback_hours: 24
    min_samples: 4
    soft_threshold: 0.50
    hard_threshold: 0.33
    confidence_penalty: 0.7

price_monitor:
  enabled: true
  interval_minutes: 10             # Layer 4: 監視間隔（分）
  alert_threshold_pct: 0.003       # 損失 0.3% で最初の通知
  alert_step_pct: 0.002            # 追加 0.2% ごとに再通知（スパム防止）
  emergency_close_pct: 0.008       # 損失 0.8% で緊急損切り（0 = 無効）
  enable_emergency_close: false    # 緊急損切りを有効にするか（false = 通知のみ）
  # トレーリングストップ（段階型・利益保護）

schedule:
  run_times:
    - "15:00"
    - "21:30"
  timezone: "Asia/Tokyo"
  # technical 収集の間隔（時間）。trade/watch 別に調整可能（既定はどちらも 1h = 毎時）。
  # trade は将来 cadence resolver で boost される土台、watch は低頻度固定用。
  # 収集スケジュールはこの interval から生成し union dispatch で回す
  # （exit_check の毎時:00 はこれとは独立で固定）。
  technical_trade_interval_hours: 1
  technical_watch_interval_hours: 1
  # cadence resolver による可変 interval 収集 (§5.3/§5.6)。false = 現行の毎時 union
  # dispatch を維持。true で「経済カレンダー/市場 state の boost に応じて trade の収集
  # 頻度を動的に上げる」cadence_driver に切替 (watch は base 固定)。
  cadence_enabled: false
  cadence_boost_interval_minutes: 5      # boost 中の収集間隔 (分)

analysis:
  # テクニカル指標の有効/無効
  indicators:
    moving_averages: true    # SMA(20/50/200) / EMA(12/26)
    rsi: true
    macd: true
    bollinger_bands: true
    atr: true
    adx: true
    ichimoku: true           # 一目均衡表

  # チャートパターン検出
  chart_patterns:
    # ── ローソク足パターン ────────────────────────────
    hammer: true              # ハンマー（下ヒゲ長・下降トレンド末）
    shooting_star: true       # シューティングスター（上ヒゲ長・上昇トレンド末）
    engulfing: true           # 包み足（強気/弱気エングルフィング）
    doji: true                # 十字線（始値≒終値）
    morning_evening_star: true  # モーニング/イブニングスター（3本）
    three_soldiers_crows: true  # 三白兵/三黒烏（連続3本同方向）
    pin_bar: true             # ピンバー（最長ヒゲ≥実体×3）
    inside_bar: true          # インサイドバー（前足の範囲内に収まる）

    # ── チャート形状パターン ──────────────────────────
    double_top_bottom: false  # ダブルトップ/ダブルボトム
    head_shoulders: false     # ヘッド＆ショルダー（通常/逆）
    triangle: false           # 三角保ち合い（上昇/下降/対称）
    range_bound: false        # レンジ相場検出

    # ── ブレイクアウト系 ──────────────────────────────
    bb_squeeze: false         # BBスクイーズ（ボラティリティ収縮）
    atr_contraction: false    # ATR収縮（ブレイクアウト前兆）
    sr_breakout: false        # サポート/レジスタンス・ブレイク

  # 選択的 Multi-Timeframe (MTF) 分析
  #   各 TF で compute_indicators() を別々に呼び、規則的に合成してrule-baseで
  #   bias_score / direction / confidence を決定する。
  #   LLM には短期 TF の詳細 + 小さな MTF サマリーブロックを渡し、
  #   エントリー水準 / SL / TP の決定に集中させる。
  #
  #   long   (regime):    大局レジーム判定 — Ichimoku + SMA + ADX + 長期パターン
  #   medium (structure): セットアップ判定  — SMA + ADX + 全パターン
  #   short  (full):      エントリー判定    — 既存の全指標セット (形状パターンは除外)
  multi_timeframe:
    enabled: true                  # false で従来の単一 TF (1h) 動作に fallback
    long:
      lookback_days: 90            # 90 本の日足 (原作者設計の Ichimoku 日足レベル)
      interval: "1d"
      enabled: true
    medium:
      lookback_days: 14            # 14 × 6 = 84 本の 4h 足 (pattern 検出に十分)
      interval: "4h"
      enabled: true
    short:
      lookback_days: 2             # 48 本の 1h 足 (エントリー timing)
      interval: "1h"
      enabled: true
    # 合成重み (合計 1.0 が推奨。欠落 TF は自動的に再正規化される)
    weights:
      long: 0.40
      medium: 0.35
      short: 0.25

  # 予測サイクル設定（技術+ニュース合成シグナルの定期検証）
  forecast_review_interval_hours: 6    # B: 予測から検証までの時間（6h = 1セッション）
  forecast_start_hour: 2               # 予測サイクル開始時刻オフセット（2 → 02:00/10:00/18:00 JST）
  forecast_min_combined_score: 0.25    # C: この絶対値未満のシグナルは予測対象外（deadband回避）
  forecast_significance_atr_ratio: 0.30  # A: ATR proxy の何倍以上動いたら有意とするか

news_collection:
  interval_minutes: 15             # この間隔でtimezoneに揃えた時刻を自動生成（OHLCV+テクニカル分析も同時実行）
  offset_minutes: 0                # 開始オフセット（例: 15 → :15, :30, :45, :00 の順に実行）
  timezone: "Asia/Tokyo"
  inter_pair_delay_seconds: 10     # ペア間の待機（Ollama VRAM保護）
  news_freshness_hours: 24         # この時間以上古い記事は除外
  summary_max_chars: 600           # RSS summary の切り捨て文字数（LLM context に合わせて調整）
  # Deep fetch (新規記事のみ trafilatura で本文取得)
  # 既知記事は title+summary だけ、新規記事のみ本文を含めて LLM プロンプトに投入
  deep_fetch_enabled: true              # false で従来動作 (タイトル+サマリーのみ)
  deep_fetch_timeout_seconds: 8.0       # 1 記事あたりの HTTP タイムアウト
  deep_fetch_max_chars: 3000            # 本文の切詰上限 (LLM context 配慮)
  deep_fetch_max_concurrent: 3          # 同時 HTTP fetch の上限 (同一 host 配慮)
  deep_fetch_user_agent: "finance-news-collector/1.0"

# keywords → config/news_sources.yaml に分離
# news_sources → config/news_sources.yaml に分離

rag:
  db_path: "data/rag"
  embedding_model: "nomic-embed-text"
  # embedding プロバイダー: "ollama" (従来) | "llamacpp" (llama-swap 経由)
  embedding_provider: "ollama"
  # embedding プロバイダーの接続先 URL。空欄なら起動時 ConfigError。
  # LLM 用 provider_config.base_url とは独立 (LLM が claude-cli でも embedding は ollama を使えるため)。
  # 例: ollama   → "http://localhost:11434"
  #     llamacpp → "http://localhost:8080/v1"
  embedding_base_url: "http://localhost:11434"
  news_lookback_hours: 24
  retrieval_top_k: 5
  reflection_lookback_count: 3
  analysis_lookback_hours: 8       # 取引判定時に集約するテクニカル分析の時間幅（最大32スナップショット）

notification:
  enabled: false                   # true で Discord 通知を有効化（DISCORD_WEBHOOK_URL 必須）
  notify_on_order_open: true       # 注文発注時に通知
  notify_on_order_close: true      # 決済時に通知（SL/TP到達・緊急損切り含む）
  notify_on_signal_skipped: true   # スキップ（既存ポジション）/ 保留（hold）時に通知（判断理由付き）
  notify_on_price_alert: true      # 価格急変動（損失方向）を検知した場合
  notify_on_cycle_summary: true    # 取引サイクル結果を1通に集約して通知 (false で旧 per-event 通知)

# 経済指標カレンダー（TradingView非公式API経由）
economic_calendar:
  enabled: false                   # true で経済指標カレンダー連携を有効化
  fetch_time: "06:00"
  fetch_timezone: "Asia/Tokyo"
  lookahead_hours: 48
  currencies: ["USD", "JPY", "EUR", "GBP"]
  min_importance: 0
  post_event_window_min: 30
  post_event_impact_min: 1
  refresh_lookback_min: 60

# 週次自己診断レポート (FX 休場の週末に走らせる、cron 不要 / schedule ライブラリ使用)
# 過去 N 日のパフォーマンス・予測精度・LLM 使用量・現状設定を集約して
# Claude (claude-cli) に診断させ、Markdown + Discord embed で配信する。
weekly_diagnosis:
  enabled: false                   # true で週次レポートを有効化
  weekday: "saturday"              # monday / tuesday / ... / sunday
  at_time: "09:00"                 # HH:MM (news_collection の timezone を使用)
  lookback_days: 7
  llm_role: "reflection"           # llm.<role> から client を取得 (claude-cli 推奨)
  output_dir: "reports"            # プロジェクトルート相対、自動 mkdir
  notify_discord: true             # 完了時に Discord embed でサマリ通知

# data/ ディレクトリの定期バックアップ (sync 失敗・破損対策)
# data/ を zip 化して output_dir 配下に世代保存し、retention_count を超えた古いものは削除
data_backup:
  enabled: true                    # false で無効化
  at_time: "03:10"                 # HH:MM (news_collection の timezone)。tech 処理 (毎時) と被らない時刻
  output_dir: "backup/data"        # プロジェクトルート相対、自動 mkdir
  retention_count: 30              # 保持世代数 (古いものから自動削除)

# mt5_bridge → config/providers/mt5.yaml に分離 (live_broker=mt5 のとき必須)

# ── Orchestrator Agent Loop (spec §12) ─────────────────────────
# Phase 1 foundation. enabled=false で既存サイクルに影響しない。
orchestrator:
  enabled: false
  mode: shadow  # observe | shadow | live
  pairs: [USDJPY=X, EURUSD=X]  # 空なら tradeable instruments を使う
  policy:
    trade_horizon: swing    # day | swing
    advice_memo: ""         # 自然文助言メモ (参考程度・hard gate 不可侵)
  market_state:
    calm_seconds: 300
    normal_seconds: 60
    active_seconds: 30
    critical_seconds: 60
  llm:
    max_concurrent_jobs: 1  # 固定。2 以上にしない (sequential-by-design)
    planning_timeout_seconds: 180
    execution_recheck_timeout_seconds: 30
  locks:
    pair_lock_ttl_seconds: 300
    decision_lock_ttl_seconds: 600
    order_lock_ttl_seconds: 120
  entry:
    price_move_pct: 0.15
    spread_max_pips: 2.0
    news_impact_min: 0.5
    require_fresh_technical: true
    max_quote_age_seconds: 10
    max_technical_age_seconds: 1800
  firing:
    material_news_impact_min: 0.5
    material_bias_delta_min: 0.20
    debounce_window_seconds: 180
    min_planning_interval_seconds: 1800
  agents:
    news_enabled: true
    technical_enabled: true
    execution_opinion_enabled: true
    risk_enabled: true
