# ============================================================
# 実行基盤の設定 (config/settings.yaml)
#
# config は 3 ファイルに分割されている (config migration 2026-07-20):
#   settings.yaml — 本ファイル。mode / provider 選択 / timezone / logging /
#                   api / notification / data_backup
#   llm.yaml      — LLM / agents / embedding  (必須。llm.yaml.example をコピー)
#   strategy.yaml — 売買戦略パラメータ        (必須。strategy.yaml.example をコピー)
#
# 3 ファイルは top-level ブロック単位でマージされる。同じブロックを
# 複数ファイルに書くと起動時 ConfigError になる。
# llm.yaml / strategy.yaml が無い・空の場合も起動時 ConfigError
# (既定値への無警告な転落を防ぐため)。
#
# instruments   → config/instruments.yaml
# keywords / news_sources → config/news_sources.yaml
# price_provider 設定 → config/providers/twelvedata.yaml (paper_provider=twelvedata 時)
# mt5_bridge    → config/providers/mt5.yaml (live_broker=mt5 のとき必須)
# ============================================================

# ============================================================
# モード + プロバイダ選択
# ============================================================
# mode:
#   "paper"     — 仮想資金でシミュレーション (デフォルト)
#   "live"      — 実取引 (live_broker 必須)
#   "live_test" — paper + live_broker 観察を同時実行 (実発注なし、検証用)
mode: paper

# paper_provider: paper モードの価格源 + live モードのフォールバック源
#   "yfinance"   — 無料 (15-20 分遅延、API キー不要)
#   "twelvedata" — リアルタイム (要 TWELVEDATA_API_KEY、設定: providers/twelvedata.yaml)
paper_provider: yfinance

# live_broker: 実取引時のブローカー (mode in {live, live_test} で必須)
#   "mt5"   — MT5 bridge 経由 (設定: providers/mt5.yaml)
#   "oanda" — OANDA REST API (設定: providers/oanda.yaml、未実装)
#   null    — paper モードのとき
live_broker: null

# 全スケジューラ登録と local_now() が使う唯一のタイムゾーン (必須)。
# 旧 schedule.timezone / news_collection.timezone /
# economic_calendar.fetch_timezone を統合 (config migration 2026-07-20)。
# 注意: db_now() は OS ローカル TZ であり、この設定とは独立。
timezone: "Asia/Tokyo"

logging:
  level: "INFO"
  file: "logs/finance.log"
  activity_log_file: "logs/activity.log"  # [COLLECT][NEWS][SIGNAL][CLOSE][TRADE][ORDER][REFLECT] 専用
  rotate_timing: "10MB"  # サイズ: 10MB / 512KB など。時間: 6H（毎6時間）/ 1D（毎日）/ midnight（日次0時）/ W0（月曜）
  backup_count: 5

api:
  enabled: false             # true で REST API サーバーを起動
  port: 8811                 # リッスンポート
  ask_soft_timeout_sec: 60         # POST /ask: 同上
  # 認証: .env の API_SECRET_KEY を設定（X-API-Key ヘッダーで送信）

notification:
  enabled: false                   # true で Discord 通知を有効化（DISCORD_WEBHOOK_URL 必須）
  notify_on_order_close: true      # 決済時に通知（SL/TP到達・緊急損切り含む）
  notify_on_price_alert: true      # 価格急変動（損失方向）を検知した場合

# data/ ディレクトリの定期バックアップ (sync 失敗・破損対策)
# data/ を zip 化して output_dir 配下に世代保存し、retention_count を超えた古いものは削除
data_backup:
  enabled: true                    # false で無効化
  at_time: "03:10"                 # HH:MM (top-level timezone)。tech 処理 (毎時) と被らない時刻
  output_dir: "backup/data"        # プロジェクトルート相対、自動 mkdir
  retention_count: 30              # 保持世代数 (古いものから自動削除)
