logging:
  level: "INFO"
  file: "logs/finance.log"
  activity_log_file: "logs/activity.log"  # [COLLECT][NEWS][SIGNAL][CLOSE][TRADE][ORDER][REFLECT] 専用
  rotate_timing: "10MB"  # サイズ: 10MB / 512KB など。時間: 6H（毎6時間）/ 1D（毎日）/ midnight（日次0時）/ W0（月曜）
  backup_count: 5

api:
  enabled: false             # true で REST API サーバーを起動
  port: 8811                 # リッスンポート
  run_trade_soft_timeout_sec: 10   # POST /run/trade: この秒数内に完了したら同期返答、超過で非同期化+webhook
  ask_soft_timeout_sec: 60         # POST /ask: 同上
  # 認証: .env の API_SECRET_KEY を設定（X-API-Key ヘッダーで送信）

# ============================================================
# LLM設定 — ニュース分析 / 価格分析 / 振り返り生成を個別に設定
#
# provider:
#   "ollama"  — ローカル Ollama（デフォルト、API KEY不要）
#   "gemini"  — Google Gemini API  （GEMINI_API_KEY 必須）
#   "openai"  — OpenAI API         （OPENAI_API_KEY 必須）
#   "claude"  — Anthropic Claude   （ANTHROPIC_API_KEY 必須）
#
# model: 空文字 "" = 各プロバイダーセクションのデフォルトモデルを使用
#        明示的に指定する場合は例: model: "gemini-2.5-pro-preview"
# ============================================================
llm:
  # Ollama 接続設定（model 指定は各ロールで行う）
  ollama:
    base_url: "http://localhost:11434"
    timeout_seconds: 120
    max_retries: 2
    max_concurrent: 2              # 同時分析数上限（VRAM保護）

  # model 未指定時は config.py の _DEFAULT_OLLAMA_MODEL（llama3.1:8b）を使用
  news_analysis:
    provider: "ollama"
    temperature: 0.3
    model: ""
  price_analysis:
    provider: "ollama"
    temperature: 0.1
    model: ""
  reflection:
    provider: "ollama"
    temperature: 0.3
    model: ""

# Gemini API 設定（provider: "gemini" のときに参照）
gemini:
  model: "gemini-2.0-flash"        # gemini-2.5-pro-preview / gemini-1.5-flash なども可
  timeout_seconds: 60
  max_retries: 2

# OpenAI API 設定（provider: "openai" のときに参照）
openai:
  model: "gpt-4o-mini"             # gpt-4o / o3-mini なども可
  timeout_seconds: 60
  max_retries: 2

# Anthropic Claude 設定（provider: "claude" のときに参照）
claude:
  model: "claude-haiku-4-5-20251001"  # claude-sonnet-4-6 / claude-opus-4-6 なども可
  timeout_seconds: 60
  max_retries: 2
  max_tokens: 4096

# instruments → config/instruments.yaml に分離
# price_provider → config/instruments.yaml に分離

trading:
  initial_balance: 10000.0
  risk_per_trade: 0.02
  signal_confidence_threshold: 0.55
  lookback_days: 90
  ohlcv_interval: "1h"             # yfinance の足種（1h足で毎時:00のテクニカル分析に対応）
  news_weight: 0.40
  price_weight: 0.60
  signal_deadband: 0.15            # BUY/SELL判定のスコア閾値（±）
  min_lot_size: 1000.0             # 最小ロットサイズ
  lot_unit: 1000.0                 # ロット切り捨て単位
  # trading_mode: "paper" | "signal_only" | "live"
  # - paper: ペーパートレード（シミュレーション）
  # - signal_only: シグナル通知 + 内部自動RAG学習 + 手動ポジション管理
  # - live: OANDA自動発注（未実装）
  trading_mode: "paper"
  # ポジション再評価（Phase 4a: Layer 1〜3）
  position_review_enabled: false        # true で有効化
  reversal_confidence_min: 0.70         # Layer 1: 反転シグナルの最低信頼度
  reversal_score_threshold: 0.25        # Layer 1: 反転スコアの絶対値閾値
  max_holding_days: 10                  # Layer 2: 最大保有日数
  timeout_min_progress_pct: 0.30        # Layer 2: この進捗率未満でタイムアウト決済
  profit_lock_min_progress_pct: 0.40    # Layer 3: TP方向への進捗率がこれ以上で利益ロック候補
  profit_lock_score_floor: 0.15         # Layer 3: シグナルスコア絶対値がこれ未満で利益ロック
  # RAG方向別スコア補正
  rag_adjustment_enabled: true
  rag_adjustment_max: 0.15
  rag_adjustment_min_hits: 2
  rag_adjustment_search_top_n: 5
  rag_adjustment_same_weight: 0.10
  rag_adjustment_opposite_weight: 0.10
  rag_adjustment_trade_multiplier: 1.0
  rag_adjustment_forecast_multiplier: 0.5
  rag_adjustment_hold_multiplier: 0.3
  # ATRベースSL/TP
  sl_atr_mult_default: 1.5            # SL距離 = ATR(14) × この倍率
  tp_atr_mult_default: 3.0            # TP距離 = ATR(14) × この倍率
  sl_atr_mult_min: 0.5                # LLM動的更新の下限
  sl_atr_mult_max: 3.0                # LLM動的更新の上限
  tp_atr_mult_min: 1.0
  tp_atr_mult_max: 6.0
  # TradingView テクニカルサマリー (矛盾検出)
  tv_summary_enabled: false      # TV判定と方向矛盾時にconfidence減衰
  tv_conflict_dampen: 0.7        # 矛盾時のconfidence倍率

price_monitor:
  enabled: true
  interval_minutes: 10             # Layer 4: 監視間隔（分）
  alert_threshold_pct: 0.003       # 損失 0.3% で最初の通知
  alert_step_pct: 0.002            # 追加 0.2% ごとに再通知（スパム防止）
  emergency_close_pct: 0.008       # 損失 0.8% で緊急損切り（0 = 無効）
  enable_emergency_close: false    # 緊急損切りを有効にするか（false = 通知のみ）
  # トレーリングストップ（段階型・利益保護）
  trailing_stop_enabled: false
  trailing_stop_breakeven_pct: 0.20    # TP距離の20%到達でSL=entry。10%(=半分)でSL=entryと元SLの中間
  trailing_stop_activation_pct: 0.40   # TP距離の40%到達で動的追従(current - 元SL距離×ratio)
  trailing_stop_distance_ratio: 1.0    # 動的追従時のSL距離倍率（1.0 = 元SLと同じ幅）

schedule:
  run_times:
    - "15:00"
    - "21:30"
  timezone: "Asia/Tokyo"

analysis:
  # テクニカル指標の有効/無効
  indicators:
    moving_averages: true    # SMA(20/50/200) / EMA(12/26)
    rsi: true
    macd: true
    bollinger_bands: true
    atr: true
    adx: true
    ichimoku: true           # 一目均衡表

  # チャートパターン検出
  chart_patterns:
    # ── ローソク足パターン ────────────────────────────
    hammer: true              # ハンマー（下ヒゲ長・下降トレンド末）
    shooting_star: true       # シューティングスター（上ヒゲ長・上昇トレンド末）
    engulfing: true           # 包み足（強気/弱気エングルフィング）
    doji: true                # 十字線（始値≒終値）
    morning_evening_star: true  # モーニング/イブニングスター（3本）
    three_soldiers_crows: true  # 三白兵/三黒烏（連続3本同方向）
    pin_bar: true             # ピンバー（最長ヒゲ≥実体×3）
    inside_bar: true          # インサイドバー（前足の範囲内に収まる）

    # ── チャート形状パターン ──────────────────────────
    double_top_bottom: false  # ダブルトップ/ダブルボトム
    head_shoulders: false     # ヘッド＆ショルダー（通常/逆）
    triangle: false           # 三角保ち合い（上昇/下降/対称）
    range_bound: false        # レンジ相場検出

    # ── ブレイクアウト系 ──────────────────────────────
    bb_squeeze: false         # BBスクイーズ（ボラティリティ収縮）
    atr_contraction: false    # ATR収縮（ブレイクアウト前兆）
    sr_breakout: false        # サポート/レジスタンス・ブレイク

  # 選択的 Multi-Timeframe (MTF) 分析
  #   各 TF で compute_indicators() を別々に呼び、規則的に合成してrule-baseで
  #   bias_score / direction / confidence を決定する。
  #   LLM には短期 TF の詳細 + 小さな MTF サマリーブロックを渡し、
  #   エントリー水準 / SL / TP の決定に集中させる。
  #
  #   long   (regime):    大局レジーム判定 — Ichimoku + SMA + ADX + 長期パターン
  #   medium (structure): セットアップ判定  — SMA + ADX + 全パターン
  #   short  (full):      エントリー判定    — 既存の全指標セット (形状パターンは除外)
  multi_timeframe:
    enabled: true                  # false で従来の単一 TF (1h) 動作に fallback
    long:
      lookback_days: 90            # 90 本の日足 (原作者設計の Ichimoku 日足レベル)
      interval: "1d"
      enabled: true
    medium:
      lookback_days: 14            # 14 × 6 = 84 本の 4h 足 (pattern 検出に十分)
      interval: "4h"
      enabled: true
    short:
      lookback_days: 2             # 48 本の 1h 足 (エントリー timing)
      interval: "1h"
      enabled: true
    # 合成重み (合計 1.0 が推奨。欠落 TF は自動的に再正規化される)
    weights:
      long: 0.40
      medium: 0.35
      short: 0.25

  # 予測サイクル設定（技術+ニュース合成シグナルの定期検証）
  forecast_review_interval_hours: 6    # B: 予測から検証までの時間（6h = 1セッション）
  forecast_start_hour: 2               # 予測サイクル開始時刻オフセット（2 → 02:00/10:00/18:00 JST）
  forecast_min_combined_score: 0.25    # C: この絶対値未満のシグナルは予測対象外（deadband回避）
  forecast_significance_atr_ratio: 0.30  # A: ATR proxy の何倍以上動いたら有意とするか

news_collection:
  interval_minutes: 15             # この間隔でtimezoneに揃えた時刻を自動生成（OHLCV+テクニカル分析も同時実行）
  offset_minutes: 0                # 開始オフセット（例: 15 → :15, :30, :45, :00 の順に実行）
  timezone: "Asia/Tokyo"
  inter_pair_delay_seconds: 10     # ペア間の待機（Ollama VRAM保護）
  news_freshness_hours: 24         # この時間以上古い記事は除外
  summary_max_chars: 600           # RSS summary の切り捨て文字数（LLM context に合わせて調整）

# keywords → config/news_sources.yaml に分離
# news_sources → config/news_sources.yaml に分離

rag:
  db_path: "data/rag"
  embedding_model: "nomic-embed-text"
  news_lookback_hours: 24
  retrieval_top_k: 5
  reflection_lookback_count: 3
  analysis_lookback_hours: 8       # 取引判定時に集約するテクニカル分析の時間幅（最大32スナップショット）

notification:
  enabled: false                   # true で Discord 通知を有効化（DISCORD_WEBHOOK_URL 必須）
  notify_on_order_open: true       # 注文発注時に通知
  notify_on_order_close: true      # 決済時に通知（SL/TP到達・緊急損切り含む）
  notify_on_signal_skipped: true   # スキップ（既存ポジション）/ 保留（hold）時に通知（判断理由付き）
  notify_on_price_alert: true      # 価格急変動（損失方向）を検知した場合

# TradingView Desktop連携（オプション）
tradingview:
  enabled: false                # true で取引判定時にチャートへ自動反映
  cdp_host: "127.0.0.1"         # CDP ホスト（WSLからWindowsへは `cat /etc/resolv.conf` の gateway IP を指定）
  cdp_port: 9222                # TradingView Desktop の CDP ポート

# 経済指標カレンダー（TradingView非公式API経由）
economic_calendar:
  enabled: false                   # true で経済指標カレンダー連携を有効化
  fetch_time: "06:00"
  fetch_timezone: "Asia/Tokyo"
  lookahead_hours: 48
  currencies: ["USD", "JPY", "EUR", "GBP"]
  min_importance: 0
  post_event_window_min: 30
  post_event_impact_min: 1
  refresh_lookback_min: 60
