# ── 価格データプロバイダー ──────────────────────────────────────────
# yfinance: デフォルト（無料、15-20分遅延）
# twelvedata: リアルタイムFX（無料枠800req/日、要TWELVEDATA_API_KEY）
price_provider:
  realtime_provider: "yfinance"     # "yfinance" | "twelvedata"
  twelvedata:
    daily_limit: 800
    per_minute_limit: 8
    use_for_monitor: true           # price_monitorでもTwelve Dataを使うか（falseでyfinance）
    watch_symbols: []               # Twelve Data Free枠で取得するwatch銘柄（例: ["GLD"]）

# ── 取引・監視銘柄 ────────────────────────────────────────────────
instruments:
  # ── FX（取引対象: mode=trade） ──
  - symbol: "USDJPY=X"
    display_name: "USD/JPY"
    asset_type: fx
    mode: trade                     # trade = 監視+取引
    pip_value: 0.01
    base_currency: "USD"
    quote_currency: "JPY"
    enabled: true
  - symbol: "EURUSD=X"
    display_name: "EUR/USD"
    asset_type: fx
    mode: trade
    pip_value: 0.0001
    base_currency: "EUR"
    quote_currency: "USD"
    enabled: true
  - symbol: "GBPUSD=X"
    display_name: "GBP/USD"
    asset_type: fx
    mode: watch                     # watch = 監視のみ（参照FX）
    pip_value: 0.0001
    base_currency: "GBP"
    quote_currency: "USD"
    enabled: false
  # ── 株価指数（監視専用） ──
  # yfinanceのindex取得が不安定なため、安定したETFシンボルを推奨
  - symbol: "SPY"
    display_name: "S&P 500 (SPY)"
    asset_type: index
    mode: watch
    currency: "USD"
    enabled: true
  - symbol: "1321.T"
    display_name: "Nikkei 225 ETF"
    asset_type: index
    mode: watch
    currency: "JPY"
    enabled: true
  # ── マクロ参照指標（監視専用） ──
  - symbol: "UUP"
    display_name: "US Dollar Index (UUP)"
    asset_type: index
    mode: watch
    currency: "USD"
    enabled: true
  - symbol: "GLD"
    display_name: "Gold (GLD ETF)"
    asset_type: index
    mode: watch
    currency: "USD"
    enabled: true
  - symbol: "IEF"
    display_name: "US 7-10Y Treasury (IEF)"
    asset_type: index
    mode: watch
    currency: "USD"
    enabled: true                   # 債券価格 ≈ 利回り逆相関
  - symbol: "SHY"
    display_name: "US 1-3Y Treasury (SHY)"
    asset_type: index
    mode: watch
    currency: "USD"
    enabled: true
  - symbol: "USO"
    display_name: "WTI Crude Oil (USO)"
    asset_type: index
    mode: watch
    currency: "USD"
    enabled: true
