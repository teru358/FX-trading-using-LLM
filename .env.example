# ============================================================
# .env.example
# このファイルをコピーして .env を作成してください。
# cp .env.example .env
# .env は .gitignore に含めること（APIキーを絶対にコミットしない）
# ============================================================

# ============================================================
# Gemini API（llm_provider: "gemini" のときのみ必要）
# セットアップ: https://aistudio.google.com/ で API キーを取得
# ============================================================

GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# OpenAI API（provider: "openai" のときのみ必要）
# セットアップ: https://platform.openai.com/api-keys
# ============================================================

OPENAI_API_KEY=your_openai_api_key_here

# ============================================================
# Anthropic Claude API（provider: "claude" のときのみ必要）
# セットアップ: https://console.anthropic.com/
# ============================================================

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================
# Discord 通知（notification.enabled: true のときのみ必要）
# セットアップ: チャンネル設定 > 連携サービス > ウェブフック > 新しいウェブフック
# ============================================================

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

# ============================================================
# Feedly API（news_sources.feedly.enabled: true のときのみ必要）
# セットアップ: https://feedly.com/i/developer で Personal Access Token を取得
# Stream ID の確認: GET https://cloud.feedly.com/v3/categories
# ============================================================

FEEDLY_ACCESS_TOKEN=your_feedly_access_token_here

# ============================================================
# REST API 認証キー（api.enabled: true のときに必須）
# 任意の長い文字列を設定し、リクエスト時に X-API-Key ヘッダーで送信
# 生成例: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================

API_SECRET_KEY=your_api_secret_key_here

# ============================================================
# Twelve Data API（paper_provider: "twelvedata" のときのみ必要）
# セットアップ: https://twelvedata.com/ で無料アカウント登録後にAPIキーを取得
# ============================================================

TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# ============================================================
# OANDA API（mode: "live" + live_broker: "oanda" のときのみ必要）
# https://developer.oanda.com/rest-live-v20/introduction/
# ============================================================

# APIキー（OANDA管理画面 > API Access から取得）
OANDA_API_KEY=your_oanda_api_key_here

# 口座ID（OANDA管理画面で確認できる数字）
OANDA_ACCOUNT_ID=your_account_id_here

# 接続環境: "practice"（練習口座）| "live"（本番口座）
# 本番移行前に必ず practice で動作確認すること
OANDA_ENVIRONMENT=practice

# ============================================================
# MT5 Bridge API キー
# 注: MT5_BRIDGE_API_KEY は config/providers/mt5.yaml の `api_key` フィールドで管理されます。
# このファイル（.env）ではなく YAML 側で設定してください。
# ============================================================
