# MT5 ブリッジ設定 (Windows 側、git ignore 対象)
# このファイルを `.env` にコピーして実際の値を設定してください

# ── MT5 ログイン情報 ──
# OANDA 本番口座 (資金 0 / 発注しない前提)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=             # 例: OANDA-Live / OANDA-Practice (MT5 ターミナルの「サーバー」欄に表示される名前)

# ── ブリッジサーバー設定 ──
BRIDGE_HOST=0.0.0.0     # LAN 経由で stick PC から到達する想定 → 0.0.0.0
BRIDGE_PORT=8812
# API キー認証 — 空なら無認証 (LAN 内 trust モデル)、設定したら X-Bridge-Api-Key ヘッダー必須
BRIDGE_API_KEY=

# ── 安全フラグ ──
# Phase 1+2 では発注 endpoint 自体を実装していないため動作には影響しないが、
# Phase 3 以降の発注機能を組込む際にこのフラグで dry-run 動作を強制する想定
DRY_RUN=true
